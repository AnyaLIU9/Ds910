# Copy this file to .env. Never commit credentials or access tokens.

# ---------- Host and local paths ----------
DATA_ROOT=/data/dsv4
SOURCE_ROOT=/data/dsv4/sources
MODEL_ROOT=/data/dsv4/models
RESULT_ROOT=/data/dsv4/results
NPU_IDS=3,5

# ---------- Internal mirrors ----------
HF_ENDPOINT=https://hf.internal.example.com
HF_HOME=/data/dsv4/cache/huggingface
HF_HUB_DISABLE_XET=1
HF_HUB_DISABLE_TELEMETRY=1

MODELSCOPE_ENDPOINT=https://modelscope.internal.example.com
MODELSCOPE_HOME=/data/dsv4/cache/modelscope
MODELSCOPE_CACHE=/data/dsv4/cache/modelscope

PIP_INDEX_URL=https://pypi.internal.example.com/simple
PIP_TRUSTED_HOST=pypi.internal.example.com

# Replace these with internal Git mirrors when the server cannot access public Git.
CANN_RECIPES_URL=https://gitcode.com/cann/cann-recipes-infer.git
KTRANSFORMERS_URL=https://github.com/kvcache-ai/ktransformers.git
SGLANG_URL=https://github.com/iforgetmyname/sglang.git
LLAMA_CPP_URL=https://github.com/ggerganov/llama.cpp.git
GPQA_GIT_URL=https://www.modelscope.cn/datasets/modelscope/gpqa.git

# ---------- Pinned source revisions ----------
# CANN Recipes merge containing the single-NPU offload delivery.
CANN_RECIPES_REV=1a7fbd34
KTRANSFORMERS_REV=d7b5b49
SGLANG_REV=298193eb3
LLAMA_CPP_REV=a94e6ff
GPQA_REV=3481c2b00a22d8256f6b845f256aa4cd4b654132

# ---------- Container ----------
# Point this at the existing image or an internal Harbor tag.
DOCKER_IMAGE=harbor.internal.example.com/ai/sglang:deepseek-v4-npu-910b
NPU_DEVICE_ID=3
SERVICE_PORT=8020

# ---------- Model assets ----------
W8A8_MODEL_ID=sgl-npu/DeepSeek-V4-Flash-W8A8
W8A8_MODEL_REVISION=master
W8A8_MODEL_PATH=/data/dsv4/models/DeepSeek-V4-Flash-W8A8

MXFP4_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash
MXFP4_MODEL_REVISION=main
MXFP4_SOURCE_PATH=/data/dsv4/models/DeepSeek-V4-Flash-MXFP4
GGUF_DIR=/data/dsv4/models/gguf
GGUF_TEMPLATE=/data/dsv4/models/gguf/dsv4_layer{layer_idx}_mxfp4.gguf

# Set to 1 only when intentionally starting the ~425 GiB model download.
CONFIRM_LARGE_DOWNLOAD=0

# ---------- Serving benchmark ----------
API_BASE_URL=http://127.0.0.1:8020
SERVED_MODEL_NAME=DeepSeek-V4-Flash
TOKENIZER_PATH=/data/dsv4/models/DeepSeek-V4-Flash-W8A8
BENCH_INPUT_LEN=1024
BENCH_OUTPUT_LEN=128
BENCH_NUM_PROMPTS=200
BENCH_CONCURRENCY_LIST="1 3 10 30 100"

# ---------- GPQA-Diamond ----------
GPQA_DIR=benchmarks/gpqa
EVAL_API_URL=http://127.0.0.1:8020/v1
EVAL_API_KEY=EMPTY
GPQA_ROUNDS=3
GPQA_MAX_TOKENS=32768
GPQA_TIMEOUT_SECONDS=60000
